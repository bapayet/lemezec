# Copier en .env.local et remplir avec les clés de TON projet Supabase (Project Settings → API).
# Sans les deux premières variables, l'app tourne en mode local (mots du fichier seed, rien n'est enregistré).

# Publiques (envoyées au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrètes (serveur uniquement, jamais préfixées NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne aléatoire longue ; Vercel l'envoie en en-tête Authorization: Bearer au cron
CRON_SECRET=

# Contact envoyé au Wiktionnaire dans le User-Agent (leur politique l'exige)
WIKTIONARY_CONTACT=
